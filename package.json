{
  "name": "@kupola/kupola",
  "version": "3.5.0",
  "description": "Kupola is a lightweight reactive application platform for building modern web applications. Kupola 是一个轻量级的响应式应用平台，用于构建现代化的 Web 应用",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/platform",
    "packages/components",
    "packages/ai-adapter",
    "packages/auth",
    "packages/router",
    "packages/create-kupola"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "knip": {
    "ignoreExportsUsedInFile": true,
    "include": [
      "files",
      "dependencies",
      "exports",
      "types",
      "enumMembers",
      "unlisted",
      "binaries",
      "unresolved",
      "nsExports",
      "nsTypes"
    ],
    "workspaces": {
      ".": {
        "entry": [
          "scripts/*.mjs"
        ],
        "project": [
          "**/*.js",
          "**/*.mjs",
          "**/*.cjs",
          "!**/dist/**",
          "!**/node_modules/**"
        ],
        "ignore": [
          "benchmark/**",
          "docs-site/**",
          "packages/create-kupola/templates/**",
          "vscode-kupola/**",
          "plugins/**",
          "packages/platform/src/*.d.ts",
          "packages/core/src/scheduler.js"
        ],
        "ignoreDependencies": [
          "@storybook/builder-vite",
          "rollup-plugin-copy",
          "vite"
        ]
      }
    }
  },
  "overrides": {
    "braces": "^3.0.3",
    "esbuild": "^0.25.0",
    "micromatch": "^4.0.8",
    "uuid": "^11.1.1",
    "vitepress": {
      "vite": "^7.0.0"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && rollup -c && npm run build:css",
    "build:rollup": "rollup -c",
    "build:css": "node scripts/build-css.cjs",
    "lint": "eslint packages/core/src packages/platform/src packages/components/src packages/auth/src packages/router/src packages/core/__tests__ packages/platform/__tests__ packages/components/__tests__ packages/auth/__tests__ packages/router/__tests__ test",
    "lint:all": "eslint . --ext .js,.mjs",
    "lint:core": "eslint packages/core/src packages/core/__tests__",
    "lint:platform": "eslint packages/platform/src packages/platform/__tests__ packages/components/__tests__ packages/core/__tests__",
    "lint:directives": "eslint packages/platform/src/directives.js packages/platform/__tests__/directives.test.js",
    "lint:fix": "npm run lint -- --fix",
    "knip": "knip --no-progress",
    "format": "prettier --write .",
    "test": "jest --config jest.config.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "bench": "jest --config jest.bench.config.mjs --testMatch=\"**/benchmark/{core,components}/**/*.bench.js\"",
    "bench:core": "jest --config jest.bench.config.mjs --testMatch=\"**/benchmark/core/**/*.bench.js\"",
    "bench:components": "jest --config jest.bench.config.mjs --testMatch=\"**/benchmark/components/**/*.bench.js\"",
    "bench:report": "node benchmark/reports/generate-report.js",
    "bench:baseline": "node benchmark/reports/check-thresholds.js --update",
    "bench:browser": "node benchmark/browser/browser.bench.js",
    "types:check": "tsc -p tsconfig.public-api.json",
    "package:smoke": "node scripts/package-smoke.mjs",
    "package:contents": "node scripts/package-contents-smoke.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "verify": "npm run lint:platform && npm run release:metadata && npm run types:check && npm run test:coverage && npm run build && npm run package:smoke && npm run package:contents && npm run docs:build && npm run size",
    "release:check": "npm run verify",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:beta": "standard-version --prerelease beta",
    "release:rc": "standard-version --prerelease rc",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:preview": "vitepress preview docs-site",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "keywords": [
    "ui",
    "components",
    "design-system",
    "frontend",
    "vanilla-js",
    "no-framework",
    "lightweight",
    "ssr",
    "server-side-rendering",
    "declarative",
    "data-binding",
    "htmx-alternative",
    "alpinejs-alternative",
    "responsive",
    "dark-theme",
    "typescript"
  ],
  "author": "kupola-cn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kupola-cn/kupola.git"
  },
  "bugs": {
    "url": "https://github.com/kupola-cn/kupola/issues"
  },
  "homepage": "https://kupola-cn.github.io/kupola/",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^8.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@size-limit/file": "^12.1.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/builder-vite": "^8.6.14",
    "@storybook/html": "^8.6.14",
    "@storybook/html-vite": "^8.6.14",
    "clean-css": "^5.3.3",
    "esbuild-jest": "^0.5.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.31.0",
    "playwright": "^1.62.0",
    "prettier": "^3.2.5",
    "rollup": "^4.13.0",
    "rollup-plugin-copy": "^3.5.0",
    "size-limit": "^12.1.0",
    "standard-version": "^9.5.0",
    "storybook": "^8.6.14",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4",
    "typescript": "^5.6.0"
  }
}
