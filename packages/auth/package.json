{
  "name": "@kupola/auth",
  "version": "3.3.7",
  "description": "Kupola auth — RBAC-based permission guard system with ABAC attribute filtering support.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/kupola-auth.cjs",
  "module": "dist/kupola-auth.esm.js",
  "types": "src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-auth.esm.js",
      "require": "./dist/kupola-auth.cjs"
    },
    "./directive": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-auth-directive.esm.js",
      "require": "./dist/kupola-auth-directive.cjs"
    },
    "./http": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-auth-http.esm.js",
      "require": "./dist/kupola-auth-http.cjs"
    },
    "./context": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-auth-context.esm.js",
      "require": "./dist/kupola-auth-context.cjs"
    }
  },
  "files": [
    "dist/",
    "src/**/*.d.ts",
    "README.md"
  ],
  "keywords": [
    "kupola",
    "auth",
    "permission",
    "rbac",
    "abac",
    "guard"
  ],
  "author": "kupola-cn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kupola-cn/kupola.git",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/kupola-cn/kupola/issues"
  },
  "homepage": "https://kupola-cn.github.io/kupola/",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@kupola/core": "^3.3.7",
    "@kupola/platform": "^3.3.7"
  },
  "devDependencies": {
    "@kupola/platform": "^3.3.7"
  },
  "scripts": {
    "test": "jest",
    "build": "rollup -c ../../rollup.config.cjs"
  }
}
