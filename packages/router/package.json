{
  "name": "@kupola/router",
  "version": "3.3.4",
  "description": "Kupola router — Complete lightweight SPA routing with nested routes, guards, transitions, and auth integration.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/kupola-router.cjs",
  "module": "dist/kupola-router.esm.js",
  "types": "src/types.d.ts",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-router.esm.js",
      "require": "./dist/kupola-router.cjs"
    },
    "./link": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-router-link.esm.js",
      "require": "./dist/kupola-router-link.cjs"
    },
    "./view": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-router-view.esm.js",
      "require": "./dist/kupola-router-view.cjs"
    },
    "./auth": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-router-auth.esm.js",
      "require": "./dist/kupola-router-auth.cjs"
    },
    "./server": {
      "types": "./src/types.d.ts",
      "import": "./dist/kupola-router-server.esm.js",
      "require": "./dist/kupola-router-server.cjs"
    }
  },
  "files": [
    "dist/",
    "src/**/*.d.ts"
  ],
  "scripts": {
    "build": "rollup -c ../../rollup.config.cjs",
    "test": "jest --testPathPattern='packages/router'"
  },
  "keywords": [
    "kupola",
    "router",
    "spa",
    "routing",
    "nested-routes",
    "guards",
    "transitions"
  ],
  "author": "Kupola Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kupola-cn/kupola.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@kupola/core": "^3.3.3",
    "@kupola/platform": "^3.3.3"
  }
}
